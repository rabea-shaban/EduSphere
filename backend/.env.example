# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/edusphere?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=supersecretjwtkeychangeinproduction
